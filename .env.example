# Application
APP_NAME=Agent Source Base
APP_VERSION=0.1.0
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DOCS_ENABLED=true

# CORS: comma-separated explicit origins. Never combine "*" with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=false

# API authentication
# Disabled only for local development. Production startup requires this to be true
# and APP_API_KEY to contain a strong random secret.
API_AUTH_ENABLED=false
APP_API_KEY=

# OpenAI / agent runtime
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_USE_RESPONSES_API=true
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
AGENT_TIMEOUT_SECONDS=45
AGENT_MODEL_CALL_LIMIT=8
AGENT_TOOL_CALL_LIMIT=6
AGENT_RECURSION_LIMIT=24
AGENT_MEMORY_ENABLED=true

# LangSmith tracing is opt-in. Traces can contain prompts, outputs, and tool data.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-source-base
