# Application
APP_NAME=KubeRAG Platform
APP_VERSION=0.1.0
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DOCS_ENABLED=true

# CORS: comma-separated explicit origins. Never combine "*" with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=false

# API authentication
# Disabled only for local development. Production startup requires this to be true
# and APP_API_KEY to contain a strong random secret.
API_AUTH_ENABLED=false
APP_API_KEY=

# RAG API skeleton
# Provider implementations for PostgreSQL/pgvector and llama.cpp are added in later phases.
RAG_TIMEOUT_SECONDS=45
RAG_MAX_CONTEXT_CHARS=12000
