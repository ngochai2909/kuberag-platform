# Application
APP_NAME=KubeRAG Platform
APP_VERSION=0.1.0
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DOCS_ENABLED=true

# CORS: comma-separated explicit origins. Never combine "*" with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=false

# API authentication
# Disabled only for local development. Production startup requires this to be true
# and APP_API_KEY to contain a strong random secret, unless the explicitly
# temporary PUBLIC_DEMO_MODE is enabled by the GCP demo overlay.
API_AUTH_ENABLED=false
APP_API_KEY=
PUBLIC_DEMO_MODE=false

# RAG request path. Keep disabled on the laptop unless PostgreSQL, E5 cache,
# and llama.cpp are intentionally configured.
RAG_TIMEOUT_SECONDS=45
RAG_MAX_CONTEXT_CHARS=12000
RAG_RUNTIME_ENABLED=false
RAG_EMBEDDING_CACHE=/models
RAG_EMBEDDING_LOCAL_ONLY=true
RAG_DATABASE_CONNECT_TIMEOUT_SECONDS=5
LLAMA_CPP_BASE_URL=http://kuberag-llm.rag.svc.cluster.local:8080
LLAMA_CPP_MODEL=kuberag-qwen2.5-1.5b
LLAMA_CPP_MAX_TOKENS=256
LLAMA_CPP_TEMPERATURE=0.2

# PostgreSQL/pgvector
# Local placeholder only. Runtime workloads must read the CNPG-generated
# `kuberag-pg-app` Secret and connect through Service `kuberag-pg-rw`.
DATABASE_URL=postgresql://kuberag:CHANGE_ME@localhost:5432/kuberag

# Prefect ingestion (schedule is declared in code; server/worker deploy later)
# Daily cron is versioned as DAILY_INGEST_CRON=0 2 * * * UTC in
# apps/ingestion/src/ingestion/flows/ingest.py
PREFECT_API_URL=

# Embedding
# Laptop/unit tests: fake (default). Cluster worker: e5 after model download Job.
KUBERAG_EMBEDDING_MODE=fake
KUBERAG_EMBEDDING_CACHE=
KUBERAG_EMBEDDING_LOCAL_ONLY=false
KUBERAG_EMBEDDING_BATCH_SIZE=16
