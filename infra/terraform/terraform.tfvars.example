# Copy this file to terraform.tfvars. Terraform ignores that local file in Git.
project_id = "YOUR_GCP_PROJECT_ID"

# Use the public IPv4 address of the administrator machine with a /32 suffix.
# Never use 0.0.0.0/0 for SSH or the Kubernetes API.
admin_source_cidr = "203.0.113.10/32"

# Paste the complete contents of ~/.ssh/kuberag_gcp.pub.
# A public key is not a credential, but the machine-specific value stays local.
ssh_public_key = "ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY kuberag-gcp"

# Empty means Envoy port 8080 is reachable only from admin_source_cidr.
# Public demo access requires a separately reviewed firewall change.
gateway_source_cidrs = []

# Defaults match the current temporary single-node architecture.
region            = "asia-southeast1"
zone              = "asia-southeast1-b"
machine_type      = "e2-custom-8-16384"
boot_disk_size_gb = 30
data_disk_size_gb = 150
disk_type         = "pd-balanced"

# Final topology workers are private-only. The application worker has 4 vCPU /
# 16 GiB so llama.cpp can use its four configured generation threads; the
# observability worker remains 2 vCPU / 8 GiB. Their data disks hold k3s
# local-path volumes and model caches.
observability_worker_machine_type = "e2-custom-2-8192"
application_worker_machine_type   = "e2-custom-4-16384"
worker_boot_disk_size_gb          = 30
worker_data_disk_size_gb          = 50
worker_private_ips = {
  observability = "10.42.0.3"
  application   = "10.42.0.4"
}

artifact_registry_repository_id = "kuberag"
github_repository              = "ngochai2909/kuberag-platform"
